{
  "name": "virtual-debond",
  "productName": "Virtual Debond",
  "version": "1.0.0",
  "description": "Removes orthodontic brackets and cement from intraoral scans and rebuilds the enamel underneath.",
  "main": "electron/main.js",
  "license": "CC0-1.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.smileworks.virtualdebond",
    "productName": "Virtual Debond",
    "files": ["index.html", "vendor/**", "electron/**", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.medical" },
    "linux": { "target": ["AppImage"], "category": "Science" }
  }
}
